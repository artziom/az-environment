#TIMEZONE
TZ=Europe/Warsaw

#POSTGRES
POSTGRES_DB=database
POSTGRES_USER=user
POSTGRES_PASSWORD=CHANGE_ME

#SYMFONY
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=CHANGE_ME
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?serverVersion=17&charset=utf8
DEFAULT_URI=https://${BACKEND_SUBDOMAIN}.${DOMAIN_NAME}
FRONTEND_URL=https://${FRONTEND_SUBDOMAIN}.${DOMAIN_NAME}
CORS_ALLOW_ORIGIN=^https://${FRONTEND_SUBDOMAIN}\.${DOMAIN_NAME}$
JWT_PASSPHRASE=CHANGE_ME
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

#NEXT.JS
API_URL=http://php:8000/api
SESSION_SECRET=CHANGE_ME
